#!/bin/sh
# Runs a command inside the development container, so that nothing has to be
# installed on the host besides Docker.
#
#   bin/dev go test ./...
#   bin/dev go test -tags integration ./...
#   bin/dev sh -c 'cd web && pnpm install --frozen-lockfile && pnpm lint && pnpm test'
#   bin/dev make build
#   bin/dev            # interactive shell
#
# The image is built from dev/Dockerfile on first use and rebuilt whenever
# that file changes.
#
# Environment:
#   KOROKU_DEV_TARGET  Dockerfile target to build and run: "full" (default)
#                      or "go" (no browser or Node.js; see dev/Dockerfile).
#   KOROKU_DEV_CACHE   Host directory to keep the Go and pnpm caches in,
#                      instead of the koroku-dev-* named volumes. CI sets it
#                      so that the caches can be saved between runs.
set -eu

here=$(cd "$(dirname "$0")/.." && pwd)

# Mount the main checkout at its host path. Linked worktrees live inside it
# and refer to it by absolute path, and containers started by the tests are
# created by the host's Docker daemon, which sees host paths.
common=$(git -C "$here" rev-parse --path-format=absolute --git-common-dir 2>/dev/null || echo "$here/.git")
root=$(dirname "$common")

target=${KOROKU_DEV_TARGET:-full}
case "$target" in
full) suffix="" ;;
go) suffix="-go" ;;
*)
    echo "bin/dev: unknown KOROKU_DEV_TARGET: $target (want full or go)" >&2
    exit 2
    ;;
esac

tag=$(sha256sum "$here/dev/Dockerfile" | cut -c1-12)
image="koroku-dev:$tag$suffix"
if ! docker image inspect "$image" >/dev/null 2>&1; then
    echo "bin/dev: building $image (first use or dev/Dockerfile changed)..." >&2
    docker build --target "$target" --tag "$image" "$here/dev" >&2
fi

if [ -n "${KOROKU_DEV_CACHE:-}" ]; then
    mkdir -p "$KOROKU_DEV_CACHE/go" "$KOROKU_DEV_CACHE/go-build" "$KOROKU_DEV_CACHE/pnpm-store"
    cache=$(cd "$KOROKU_DEV_CACHE" && pwd)
    cache_go=$cache/go
    cache_go_build=$cache/go-build
    cache_pnpm=$cache/pnpm-store
else
    cache_go=koroku-dev-go
    cache_go_build=koroku-dev-go-build
    cache_pnpm=koroku-dev-pnpm
fi

socket=${DOCKER_SOCKET:-/var/run/docker.sock}

if [ "$#" -eq 0 ]; then
    set -- bash
fi

# Optional flags, kept as plain words on purpose.
flags=""
if [ -t 0 ] && [ -t 1 ]; then
    flags="$flags --tty"
fi
# Pass a GitHub token through only when the caller exported one.
if [ -n "${GH_TOKEN:-}" ]; then
    flags="$flags --env GH_TOKEN"
fi

# /tmp is a tmpfs: the tests churn temporary files there, and in the
# container's writable layer that churn makes `docker system df` (which the
# integration tests call) fail while it walks the layer.
# shellcheck disable=SC2086 # $flags is a list of separate words
exec docker run --rm --interactive --init $flags \
    --network host \
    --user "$(id -u):$(id -g)" \
    --group-add "$(stat -c %g "$socket")" \
    --volume "$socket:/var/run/docker.sock" \
    --volume "$root:$root" \
    --workdir "$PWD" \
    --tmpfs /tmp:exec,mode=1777 \
    --volume "$cache_go:/cache/go" \
    --volume "$cache_go_build:/cache/go-build" \
    --volume "$cache_pnpm:/cache/pnpm-store" \
    "$image" "$@"
