{
  "name": "koroku-static",
  "services": {
    "web": {
      "image": "nginx:1.29-alpine",
      "ports": [
        {"mode": "ingress", "target": 80, "published": "8080", "protocol": "tcp"},
        {"mode": "ingress", "target": 443, "published": "8443", "protocol": "tcp"}
      ],
      "mem_limit": "134217728"
    },
    "cache": {
      "image": "valkey/valkey:8",
      "mem_limit": "67108864",
      "deploy": {"resources": {"limits": {"memory": "67108864"}}, "placement": {}}
    }
  }
}
