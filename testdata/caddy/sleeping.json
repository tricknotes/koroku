{
  "admin": {
    "listen": "127.0.0.1:2019"
  },
  "apps": {
    "http": {
      "servers": {
        "http": {
          "listen": [
            ":80"
          ],
          "routes": [
            {
              "handle": [
                {
                  "handler": "static_response",
                  "status_code": 404
                }
              ]
            }
          ]
        },
        "https": {
          "listen": [
            ":443"
          ],
          "logs": {
            "logger_names": {
              "blog.dev.example.com": "blog.app",
              "example.org": "blog.app",
              "paused.dev.example.com": "paused.app",
              "shop-staging.dev.example.com": "shop-staging.app",
              "shop.dev.example.com": "shop.app",
              "www.example.org": "blog.app"
            },
            "skip_unmapped_hosts": true
          },
          "routes": [
            {
              "handle": [
                {
                  "flush_interval": -1,
                  "handler": "reverse_proxy",
                  "upstreams": [
                    {
                      "dial": "127.0.0.1:8080"
                    }
                  ]
                }
              ],
              "match": [
                {
                  "host": [
                    "console.dev.example.com"
                  ]
                }
              ],
              "terminal": true
            },
            {
              "handle": [
                {
                  "handler": "static_response",
                  "headers": {
                    "Location": [
                      "https://www.example.org{http.request.uri}"
                    ]
                  },
                  "status_code": 308
                }
              ],
              "match": [
                {
                  "host": [
                    "blog.dev.example.com",
                    "example.org"
                  ]
                }
              ],
              "terminal": true
            },
            {
              "handle": [
                {
                  "flush_interval": -1,
                  "handler": "reverse_proxy",
                  "headers": {
                    "request": {
                      "set": {
                        "X-Koroku-Wake": [
                          "blog"
                        ]
                      }
                    }
                  },
                  "stream_close_delay": "5m",
                  "upstreams": [
                    {
                      "dial": "127.0.0.1:8080"
                    }
                  ]
                }
              ],
              "match": [
                {
                  "host": [
                    "www.example.org"
                  ]
                }
              ],
              "terminal": true
            },
            {
              "handle": [
                {
                  "body": "<!doctype html>\n<html lang=\"ja\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>停止中</title>\n</head>\n<body style=\"font-family: sans-serif; margin: 20vh auto 0; max-width: 32rem; padding: 0 1rem; color: #333;\">\n<h1 style=\"font-size: 1.25rem;\">このアプリは停止中です</h1>\n<p>しばらくしてから、もう一度アクセスしてください。</p>\n</body>\n</html>\n",
                  "handler": "static_response",
                  "headers": {
                    "Cache-Control": [
                      "no-store"
                    ],
                    "Content-Type": [
                      "text/html; charset=utf-8"
                    ]
                  },
                  "status_code": 503
                }
              ],
              "match": [
                {
                  "host": [
                    "paused.dev.example.com"
                  ]
                }
              ],
              "terminal": true
            },
            {
              "handle": [
                {
                  "handler": "reverse_proxy",
                  "stream_close_delay": "5m",
                  "upstreams": [
                    {
                      "dial": "127.0.0.1:20003"
                    }
                  ]
                }
              ],
              "match": [
                {
                  "host": [
                    "shop.dev.example.com"
                  ]
                }
              ],
              "terminal": true
            },
            {
              "handle": [
                {
                  "handler": "headers",
                  "response": {
                    "deferred": true,
                    "set": {
                      "X-Robots-Tag": [
                        "noindex"
                      ]
                    }
                  }
                },
                {
                  "handler": "subroute",
                  "routes": [
                    {
                      "handle": [
                        {
                          "handler": "reverse_proxy",
                          "upstreams": [
                            {
                              "dial": "127.0.0.1:8080"
                            }
                          ]
                        }
                      ],
                      "match": [
                        {
                          "path": [
                            "/.koroku/auth/*"
                          ]
                        }
                      ],
                      "terminal": true
                    },
                    {
                      "handle": [
                        {
                          "handler": "static_response",
                          "status_code": 404
                        }
                      ],
                      "match": [
                        {
                          "path": [
                            "/.koroku",
                            "/.koroku/*"
                          ]
                        }
                      ],
                      "terminal": true
                    },
                    {
                      "handle": [
                        {
                          "handle_response": [
                            {
                              "match": {
                                "status_code": [
                                  2
                                ]
                              },
                              "routes": [
                                {
                                  "handle": [
                                    {
                                      "handler": "vars"
                                    }
                                  ]
                                }
                              ]
                            }
                          ],
                          "handler": "reverse_proxy",
                          "headers": {
                            "request": {
                              "set": {
                                "X-Forwarded-Method": [
                                  "{http.request.method}"
                                ],
                                "X-Forwarded-Uri": [
                                  "{http.request.uri}"
                                ]
                              }
                            }
                          },
                          "rewrite": {
                            "method": "GET",
                            "uri": "/auth/gate/check"
                          },
                          "upstreams": [
                            {
                              "dial": "127.0.0.1:8080"
                            }
                          ]
                        }
                      ],
                      "match": [
                        {
                          "not": [
                            {
                              "path": [
                                "/webhooks/*"
                              ]
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "handle": [
                        {
                          "handler": "headers",
                          "request": {
                            "replace": {
                              "Cookie": [
                                {
                                  "replace": "",
                                  "search_regexp": "^__Host-koroku_gate=[^;]*(;\\s*)?"
                                },
                                {
                                  "replace": "",
                                  "search_regexp": ";\\s*__Host-koroku_gate=[^;]*"
                                }
                              ]
                            }
                          }
                        },
                        {
                          "flush_interval": -1,
                          "handler": "reverse_proxy",
                          "headers": {
                            "request": {
                              "set": {
                                "X-Koroku-Wake": [
                                  "shop-staging"
                                ]
                              }
                            }
                          },
                          "stream_close_delay": "5m",
                          "upstreams": [
                            {
                              "dial": "127.0.0.1:8080"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ],
              "match": [
                {
                  "host": [
                    "shop-staging.dev.example.com"
                  ]
                }
              ],
              "terminal": true
            },
            {
              "handle": [
                {
                  "handler": "static_response",
                  "status_code": 404
                }
              ]
            }
          ]
        }
      }
    },
    "tls": {
      "automation": {
        "policies": [
          {
            "issuers": [
              {
                "module": "acme"
              }
            ]
          }
        ]
      }
    }
  },
  "logging": {
    "logs": {
      "access-blog": {
        "encoder": {
          "format": "json"
        },
        "include": [
          "http.log.access.blog.app"
        ],
        "writer": {
          "filename": "/var/log/caddy/apps/blog.log",
          "output": "file",
          "roll_keep": 5,
          "roll_keep_days": 14,
          "roll_size_mb": 50
        }
      },
      "access-paused": {
        "encoder": {
          "format": "json"
        },
        "include": [
          "http.log.access.paused.app"
        ],
        "writer": {
          "filename": "/var/log/caddy/apps/paused.log",
          "output": "file",
          "roll_keep": 5,
          "roll_keep_days": 14,
          "roll_size_mb": 50
        }
      },
      "access-shop": {
        "encoder": {
          "format": "json"
        },
        "include": [
          "http.log.access.shop.app"
        ],
        "writer": {
          "filename": "/var/log/caddy/apps/shop.log",
          "output": "file",
          "roll_keep": 5,
          "roll_keep_days": 14,
          "roll_size_mb": 50
        }
      },
      "access-shop-staging": {
        "encoder": {
          "format": "json"
        },
        "include": [
          "http.log.access.shop-staging.app"
        ],
        "writer": {
          "filename": "/var/log/caddy/apps/shop-staging.log",
          "output": "file",
          "roll_keep": 5,
          "roll_keep_days": 14,
          "roll_size_mb": 50
        }
      },
      "default": {
        "exclude": [
          "http.log.access"
        ]
      }
    }
  }
}
