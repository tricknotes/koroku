{
  "admin": {
    "listen": "127.0.0.1:2019"
  },
  "apps": {
    "http": {
      "servers": {
        "http": {
          "listen": [
            ":80"
          ],
          "routes": [
            {
              "handle": [
                {
                  "handler": "static_response",
                  "status_code": 404
                }
              ]
            }
          ]
        },
        "https": {
          "listen": [
            ":443"
          ],
          "logs": {
            "logger_names": {
              "example.org": "shop.app",
              "shop.dev.example.com": "shop.app",
              "solo.dev.example.com": "solo.app",
              "www.example.org": "shop.app"
            },
            "skip_unmapped_hosts": true
          },
          "routes": [
            {
              "handle": [
                {
                  "flush_interval": -1,
                  "handler": "reverse_proxy",
                  "headers": {
                    "request": {
                      "delete": [
                        "X-Koroku-Wake"
                      ]
                    }
                  },
                  "upstreams": [
                    {
                      "dial": "127.0.0.1:8080"
                    }
                  ]
                }
              ],
              "match": [
                {
                  "host": [
                    "console.dev.example.com"
                  ]
                }
              ],
              "terminal": true
            },
            {
              "handle": [
                {
                  "handler": "static_response",
                  "headers": {
                    "Location": [
                      "https://www.example.org{http.request.uri}"
                    ]
                  },
                  "status_code": 308
                }
              ],
              "match": [
                {
                  "host": [
                    "example.org",
                    "shop.dev.example.com"
                  ]
                }
              ],
              "terminal": true
            },
            {
              "handle": [
                {
                  "handler": "reverse_proxy",
                  "load_balancing": {
                    "try_duration": "30s",
                    "try_interval": "250ms"
                  },
                  "stream_close_delay": "5m",
                  "upstreams": [
                    {
                      "dial": "127.0.0.1:20003"
                    }
                  ]
                }
              ],
              "match": [
                {
                  "host": [
                    "www.example.org"
                  ]
                }
              ],
              "terminal": true
            },
            {
              "handle": [
                {
                  "handler": "reverse_proxy",
                  "load_balancing": {
                    "try_duration": "30s",
                    "try_interval": "250ms"
                  },
                  "stream_close_delay": "5m",
                  "upstreams": [
                    {
                      "dial": "127.0.0.1:20004"
                    }
                  ]
                }
              ],
              "match": [
                {
                  "host": [
                    "solo.dev.example.com"
                  ]
                }
              ],
              "terminal": true
            },
            {
              "handle": [
                {
                  "handler": "static_response",
                  "status_code": 404
                }
              ]
            }
          ]
        }
      }
    },
    "tls": {
      "automation": {
        "policies": [
          {
            "issuers": [
              {
                "module": "acme"
              }
            ]
          }
        ]
      }
    }
  },
  "logging": {
    "logs": {
      "access-shop": {
        "encoder": {
          "format": "json"
        },
        "include": [
          "http.log.access.shop.app"
        ],
        "writer": {
          "filename": "/var/log/caddy/apps/shop.log",
          "output": "file",
          "roll_keep": 5,
          "roll_keep_days": 14,
          "roll_size_mb": 50
        }
      },
      "access-solo": {
        "encoder": {
          "format": "json"
        },
        "include": [
          "http.log.access.solo.app"
        ],
        "writer": {
          "filename": "/var/log/caddy/apps/solo.log",
          "output": "file",
          "roll_keep": 5,
          "roll_keep_days": 14,
          "roll_size_mb": 50
        }
      },
      "default": {
        "exclude": [
          "http.log.access"
        ]
      }
    }
  }
}
