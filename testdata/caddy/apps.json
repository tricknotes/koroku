{
  "admin": {
    "listen": "127.0.0.1:2019"
  },
  "apps": {
    "http": {
      "servers": {
        "http": {
          "listen": [
            ":80"
          ],
          "routes": [
            {
              "handle": [
                {
                  "handler": "static_response",
                  "status_code": 404
                }
              ]
            }
          ]
        },
        "https": {
          "listen": [
            ":443"
          ],
          "logs": {
            "logger_names": {
              "blog.dev.example.com": "blog.app",
              "shop-staging.dev.example.com": "shop-staging.app",
              "shop.dev.example.com": "shop.app",
              "staging.example.org": "shop-staging.app"
            },
            "skip_unmapped_hosts": true
          },
          "routes": [
            {
              "handle": [
                {
                  "flush_interval": -1,
                  "handler": "reverse_proxy",
                  "upstreams": [
                    {
                      "dial": "127.0.0.1:8080"
                    }
                  ]
                }
              ],
              "match": [
                {
                  "host": [
                    "console.dev.example.com"
                  ]
                }
              ],
              "terminal": true
            },
            {
              "handle": [
                {
                  "handler": "reverse_proxy",
                  "load_balancing": {
                    "try_duration": "30s",
                    "try_interval": "250ms"
                  },
                  "stream_close_delay": "5m",
                  "upstreams": [
                    {
                      "dial": "127.0.0.1:20001"
                    }
                  ]
                }
              ],
              "match": [
                {
                  "host": [
                    "blog.dev.example.com"
                  ]
                }
              ],
              "terminal": true
            },
            {
              "handle": [
                {
                  "handler": "reverse_proxy",
                  "load_balancing": {
                    "try_duration": "30s",
                    "try_interval": "250ms"
                  },
                  "stream_close_delay": "5m",
                  "upstreams": [
                    {
                      "dial": "127.0.0.1:20003"
                    }
                  ]
                }
              ],
              "match": [
                {
                  "host": [
                    "shop.dev.example.com"
                  ]
                }
              ],
              "terminal": true
            },
            {
              "handle": [
                {
                  "handler": "reverse_proxy",
                  "load_balancing": {
                    "try_duration": "30s",
                    "try_interval": "250ms"
                  },
                  "stream_close_delay": "5m",
                  "upstreams": [
                    {
                      "dial": "127.0.0.1:20002"
                    }
                  ]
                }
              ],
              "match": [
                {
                  "host": [
                    "shop-staging.dev.example.com",
                    "staging.example.org"
                  ]
                }
              ],
              "terminal": true
            },
            {
              "handle": [
                {
                  "handler": "static_response",
                  "status_code": 404
                }
              ]
            }
          ]
        }
      }
    },
    "tls": {
      "automation": {
        "policies": [
          {
            "issuers": [
              {
                "ca": "https://acme-staging-v02.api.letsencrypt.org/directory",
                "email": "admin@example.com",
                "module": "acme"
              }
            ]
          }
        ]
      }
    }
  },
  "logging": {
    "logs": {
      "access-blog": {
        "encoder": {
          "format": "json"
        },
        "include": [
          "http.log.access.blog.app"
        ],
        "writer": {
          "filename": "/var/log/caddy/apps/blog.log",
          "output": "file",
          "roll_keep": 5,
          "roll_keep_days": 14,
          "roll_size_mb": 50
        }
      },
      "access-shop": {
        "encoder": {
          "format": "json"
        },
        "include": [
          "http.log.access.shop.app"
        ],
        "writer": {
          "filename": "/var/log/caddy/apps/shop.log",
          "output": "file",
          "roll_keep": 5,
          "roll_keep_days": 14,
          "roll_size_mb": 50
        }
      },
      "access-shop-staging": {
        "encoder": {
          "format": "json"
        },
        "include": [
          "http.log.access.shop-staging.app"
        ],
        "writer": {
          "filename": "/var/log/caddy/apps/shop-staging.log",
          "output": "file",
          "roll_keep": 5,
          "roll_keep_days": 14,
          "roll_size_mb": 50
        }
      },
      "default": {
        "exclude": [
          "http.log.access"
        ]
      }
    }
  }
}
